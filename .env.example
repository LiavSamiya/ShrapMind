# ShrapMind configuration. Copy to .env and fill in.
#   cp .env.example .env

# ---------------------------------------------------------------- required

# Shared secret between the backend and the simulation worker. Generate with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# If left empty in dev, a token is minted at startup and printed to stderr.
# In prod mode an empty or short token refuses to boot.
WORKER_TOKEN=

# Reviewer dashboard (/review) and the admin approval routes. Separate
# credentials: a reviewer can see the queue, an admin promotes to the library.
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Postgres. Required by docker-compose.
POSTGRES_USER=shrapmind
POSTGRES_PASSWORD=
POSTGRES_DB=shrapmind
POSTGRES_PORT=5432

# ---------------------------------------------------------------- llm

# Any OpenAI-compatible endpoint. Leave LLM_BASE_URL empty to use OpenRouter.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------- optional

DATABASE_URL=postgresql://shrapmind:shrapmind@localhost:5432/shrapmind
APP_HOST=0.0.0.0
APP_PORT=7860

# Agent loop
AGENT_MAX_STEPS=15
SIMILARITY_THRESHOLD=0.85
SHRAPMIND_MAX_SIM_CALLS=40
SHRAPMIND_MAX_CANDIDATES=25

# Worker (read by the worker process only)
BACKEND_WS_URL=ws://localhost:7860
WORKER_CLIENT_ID=default

# Audit log location. Defaults to ~/.shrapmind/audit.log
SHRAPMIND_AUDIT_LOG=
SHRAPMIND_AUDIT_ROTATE_BYTES=8388608

# ---------------------------------------------------------------- dev only
# All four are force-disabled when SHRAPMIND_PROD=1, so a stray value in a
# deploy cannot quietly downgrade it to the scripted demo.

# Refuse to boot on a weak configuration.
SHRAPMIND_PROD=

MOCK_LLM=      # 1 = scripted design run, no API key needed
MOCK_AGENT=    # 1 = canned event stream, no worker or DB needed
SKIP_DB=       # 1 = no Postgres
SHRAPMIND_DEBUG=
SHRAPMIND_MOCK_ENGINES=
