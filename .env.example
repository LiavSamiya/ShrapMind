# Copy to .env and fill in. The api service refuses to start without the
# passwords: an ungated review endpoint would let anyone promote a claim
# about an enzyme into the answer set.
POSTGRES_USER=shrapmind
POSTGRES_PASSWORD=
POSTGRES_DB=shrapmind
POSTGRES_PORT=5432

DATABASE_URL=postgresql://shrapmind:@localhost:5432/shrapmind
APP_PORT=7870
SIMILARITY_THRESHOLD=0.85
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

REVIEWER_USERNAME=biologist
REVIEWER_PASSWORD=
ADMIN_PASSWORD=
SHRAPMIND_PROD=1
